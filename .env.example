# Copy this to .env and fill in your keys
ANTHROPIC_API_KEY=your_anthropic_key_here
PEXELS_API_KEY=your_pexels_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
GROQ_API_KEY=your_groq_key_here
REPLICATE_API_TOKEN=your_replicate_token_here
PORT=3001

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change_me_to_a_long_random_string

# Email (Resend) — verification codes, payment approvals, admin broadcast
RESEND_API_KEY=your_resend_key_here
ADMIN_EMAIL=digidelight33@gmail.com
ADMIN_SECRET=change_me

# Web search for the agent's real-event/historical fact-checking (Tavily)
TAVILY_API_KEY=your_tavily_key_here

# URLs
FRONTEND_URL=https://erivion.net
SITE_URL=https://erivion.net
BACKEND_URL=https://erivion.net

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://erivion.net/api/auth/google/callback

# Frontend build-time vars (set in the frontend's own .env / hosting env)
VITE_ADMIN_SECRET=change_me
VITE_INSTAPAY_NUMBER=01091917832
